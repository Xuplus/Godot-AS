[configuration]

entry_symbol = "godot_as_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

windows.editor.x86_64 = "res://bin/libgodot_as.windows.editor.x86_64.dll"
windows.debug.x86_64 = "res://bin/libgodot_as.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libgodot_as.windows.template_release.x86_64.dll"
windows.debug.x86_32 = "res://bin/libgodot_as.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "res://bin/libgodot_as.windows.template_release.x86_32.dll"
linux.editor.x86_64 = "res://bin/libgodot_as.linux.editor.x86_64.so"
linux.debug.x86_64 = "res://bin/libgodot_as.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libgodot_as.linux.template_release.x86_64.so"
web.debug.wasm32 = "res://bin/libgodot_as.web.template_debug.wasm32.nothreads.wasm"
web.release.wasm32 = "res://bin/libgodot_as.web.template_release.wasm32.nothreads.wasm"
android.debug.arm64 = "res://bin/libgodot_as.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/libgodot_as.android.template_release.arm64.so"
android.debug.x86_64 = "res://bin/libgodot_as.android.template_debug.x86_64.so"
android.release.x86_64 = "res://bin/libgodot_as.android.template_release.x86_64.so"
